    "import ipywidgets as widgets\n",
    "from IPython.display import display, clear_output\n",
    "\n",
    "# Creazione di un menu a tendina con valori prefissati della resistenza interna del voltmetro\n",
    "menu = widgets.Dropdown(\n",
    "    options=[('10 Mohm',1e7), ('200 kohm',2e5), ('1 Mohm', 1e6), ('50 ohm',50)],\n",
    "    value=1e7, # Valore iniziale predefinito\n",
    "    description='$r_V$',\n",
    "    disabled=False,\n",
    ")\n",
    "\n",
    "# Creazione delle caselle di testo per l'input di intensità di corrente e resistenza del ramo\n",
    "casella_input_1 = widgets.Text(\n",
    "    value='',\n",
    "    placeholder='Resistenza del ramo (in ohm):',\n",
    "    description='$R$ (in ohm):',\n",
    "    disabled=False\n",
    ")\n",
    "\n",
    "casella_input_2 = widgets.Text(\n",
    "    value='',\n",
    "    placeholder='Intensità di corrente nel ramo (in mA):',\n",
    "    description='$I$ (in mA):',\n",
    "    disabled=False\n",
    ")\n",
    "\n",
    "# Creazione del pulsante di invio\n",
    "pulsante = widgets.Button(\n",
    "    description='Calcola',\n",
    "    button_style='success', # Verde\n",
    "    tooltip='Clicca per confermare',\n",
    "    icon='check'\n",
    ")\n",
    "\n",
    "# Definizione area di output per mostrare il risultato\n",
    "area_output = widgets.Output(layout={'border': '1px solid red'})\n",
    "\n",
    "# Funzione che gestisce l'evento del click sul pulsante (fa anche i calcolini)\n",
    "def click(b): \n",
    "    with area_output: # Questa istruzione è specifica per ipywidgets\n",
    "        clear_output() # Pulisce i messaggi precedenti\n",
    "        R = float(casella_input_1.value) # Prende il valore di R\n",
    "        I = float(casella_input_2.value) # quello di I\n",
    "        r_V=float(menu.value) # quello di r_V\n",
    "        V_imperturbato=R*I*1e-3 # e fa i calcolini\n",
    "        V_perturbato=((R*r_V)/(R+r_V))*I*1e-3        \n",
    "        print(f'Se il voltmetro non perturbasse il circuito, la lettura sarebbe: {V_imperturbato:.2e} [V]')\n",
    "        print(f'Invece con il voltmetro in uso la lettura è: {V_perturbato:.2e} [V]')\n",
    "\n",
    "# Collegamento della funzione al pulsante\n",
    "pulsante.on_click(click)\n",
    "    \n",
    "# Stampa sul notebook dei vari elementi grafici\n",
    "display(menu,casella_input_1, casella_input_2,pulsante,area_output)"
   ]
